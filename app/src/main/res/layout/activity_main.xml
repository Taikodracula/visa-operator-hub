<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ VisaHunter Operator Hub"
            android:textColor="@color/accent_gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مركز إدارة الحسابات المعزولة والأتمتة المركزية"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <!-- Card 1: Work Profile Environment -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💼 حالة مساحة العمل (Work Profile)"
                    android:textColor="@color/accent_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvProfileStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="جاري فحص بيئة التشغيل..."
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnSetupWorkProfile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="💼 تفعيل مساحة العمل المعزولة"
                    android:textAllCaps="false"
                    android:textColor="@color/text_main"
                    android:backgroundTint="@color/primary"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnCloneAlmaviva"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="⚡ استنساخ المافيفا داخل مساحة العمل"
                    android:textAllCaps="false"
                    android:textColor="@color/text_main"
                    android:backgroundTint="@color/accent_gold"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnOpenUserSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="👥 فتح إعدادات المستخدمين المتعددين (Add User)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_muted"
                    android:backgroundTint="@color/card_stroke" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 2: Almaviva Quick Launchers -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚀 مشغّل تطبيقات المافيفا"
                    android:textColor="@color/accent_gold"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="فتح أي من التطبيقين بنقرة واحدة لتسجيل الحساب أو حل التحدي"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnLaunchPersonalAlmaviva"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📱 فتح المافيفا الأساسي (الحساب الأول)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_main"
                    android:backgroundTint="@color/primary_variant"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnLaunchWorkAlmaviva"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="💼 فتح المافيفا المعزول (الحساب الثاني)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_main"
                    android:backgroundTint="@color/accent_blue" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 3: Automated QR & MFA Clicker -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ النقر التلقائي وحل الـ QR فورياً"
                    android:textColor="@color/success"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvA11yStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="جاري فحص خدمة النقر..."
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="⚡ تفعيل خدمة النقر التلقائي"
                    android:textAllCaps="false"
                    android:textColor="@color/text_main"
                    android:backgroundTint="@color/success" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
